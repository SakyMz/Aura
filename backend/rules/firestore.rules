rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isVerifiedWoman() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Novo cadastro sempre começa pendente e não pode definir role/admin.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'profileImage', 'createdAt', 'updatedAt',
          'verificationStatus', 'verificationDocumentPath',
          'verificationSubmittedAt', 'emergencyContacts', 'selfDeclaredWoman'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'createdAt', 'updatedAt',
          'verificationStatus', 'verificationDocumentPath', 'verificationSubmittedAt'
        ])
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.selfDeclaredWoman == true
        && request.resource.data.verificationDocumentPath == 'verifications/' + userId + '/document'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;

      // A usuária pode editar somente seu perfil e reenviar documento após rejeição.
      // Campos de análise e o papel de administradora são exclusivos do admin.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'updatedAt', 'profileImage', 'emergencyContacts'
          ])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'verificationDocumentPath', 'verificationSubmittedAt',
              'verificationStatus', 'verificationReviewNote'
            ])
            && resource.data.verificationStatus in ['pending', 'rejected']
            && request.resource.data.verificationStatus == 'pending'
            && request.resource.data.verificationDocumentPath == 'verifications/' + userId + '/document'
            && request.resource.data.verificationReviewNote == ''
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || (isVerifiedWoman() && (
        resource.data.status == 'published' || resource.data.userId == request.auth.uid
      ));

      allow create: if isVerifiedWoman()
        && request.resource.data.keys().hasAll([
          'userId', 'category', 'description', 'latitude', 'longitude',
          'riskLevel', 'date', 'createdAt', 'status', 'anonymous'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.riskLevel in ['low', 'attention', 'moderate', 'high', 'critical'];

      allow update: if isAdmin() || (
        isVerifiedWoman()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'description', 'latitude', 'longitude', 'riskLevel',
          'date', 'imageUrl', 'anonymous'
        ])
      );
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || isVerifiedWoman();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'emergency';
      allow write: if isAdmin() && settingId == 'emergency';
    }
  }
}
